# Nouri app (client) environment.
# Copy to `.env`. All EXPO_PUBLIC_* vars are embedded in the app bundle,
# so only put PUBLISHABLE / PUBLIC values here — never secret keys.

# Backend base URL (the server in /server). Leave blank to run in DEMO MODE.
EXPO_PUBLIC_API_BASE_URL=

# Supabase (optional — auth + cloud sync). Leave blank to store locally only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe publishable key (safe to ship). Secret key lives on the server.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
